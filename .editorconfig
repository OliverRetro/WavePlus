root = true

[*.cs]
# Report unused using directives (needs GenerateDocumentationFile=true in the csproj to
# surface during `dotnet build` — see Plus.csproj).
dotnet_diagnostic.IDE0005.severity = warning

# Report unused / unread private members (methods, fields). NOTE: Roslyn only flags private
# members; solution-wide dead public code needs ReSharper/Rider Solution-Wide Analysis.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

csharp_new_line_before_open_brace = accessors, anonymous_methods, anonymous_types, events, indexers, lambdas, local_functions, methods, object_collection_array_initializers, properties, types

insert_final_newline = false

dotnet_style_allow_multiple_blank_lines_experimental = false
dotnet_diagnostic.IDE2000.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
