<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <StartupObject>Plus.Program</StartupObject>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <!-- Run the IDExxxx code-style analyzers (IDE0005/IDE0051/…) during `dotnet build`. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Required for IDE0005 (unused using) to be reported by `dotnet build`.
             The CS1591 "missing XML comment" noise this enables is silenced in .editorconfig. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Extracted leaf assemblies. Each keeps its original namespace (Plus.Database.EF.Entities,
             Plus.Utilities, Plus.Communication.Encryption), so this project's existing usings resolve. -->
        <ProjectReference Include="WavePlus.Entities\WavePlus.Entities.csproj" />
        <ProjectReference Include="WavePlus.Utilities\WavePlus.Utilities.csproj" />
        <ProjectReference Include="WavePlus.Cryptography\WavePlus.Cryptography.csproj" />
    </ItemGroup>

    <!-- Plus.csproj sits at the repo root and globs **/*.cs, which would otherwise also pull in the
         nested project sources (double-compile). Exclude those subtrees. -->
    <ItemGroup>
        <Compile Remove="WavePlus.Entities\**\*.cs" />
        <Compile Remove="WavePlus.Utilities\**\*.cs" />
        <Compile Remove="WavePlus.Cryptography\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- AStar.dll moved to WavePlus.Utilities (its only consumer) and flows in transitively. -->
        <Reference Include="HabboEncryption">
            <HintPath>Resources\libs\HabboEncryption.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotNetty.Buffers" Version="0.7.6" />
        <PackageReference Include="DotNetty.Codecs" Version="0.7.6" />
        <PackageReference Include="DotNetty.Codecs.Http" Version="0.7.6" />
        <PackageReference Include="DotNetty.Common" Version="0.7.6" />
        <PackageReference Include="DotNetty.Handlers" Version="0.7.6" />
        <PackageReference Include="DotNetty.Transport" Version="0.7.6" />
        <PackageReference Include="FlexLabs.EntityFrameworkCore.Upsert" Version="10.1.0" />
        <PackageReference Include="log4net" Version="3.3.2" />
        <PackageReference Include="FlexLabs.EntityFrameworkCore.Upsert" Version="10.1.0" />
        <PackageReference Include="log4net" Version="3.3.0" />
        <PackageReference Include="morelinq" Version="4.4.0" />
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="MySqlConnector" Version="2.6.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="StackExchange.Redis" Version="3.3.0" />
        <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Config\config.ini">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Config\figuredata.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="log4net.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
